{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contribution_schema.json",
  "title": "Synthetic contribution events",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "event_id",
      "schema_version",
      "contribution_type",
      "contributor",
      "research_object",
      "validation",
      "scoring_inputs",
      "issued_credential"
    ],
    "properties": {
      "event_id": {
        "type": "string",
        "pattern": "^MCT-EVT-[0-9]{4}$"
      },
      "schema_version": {
        "const": "0.3.4-alpha"
      },
      "contribution_type": {
        "enum": [
          "mof_dataset_deposition",
          "negative_synthesis_record",
          "replication_study",
          "peer_validation",
          "sample_sharing",
          "model_provenance_record",
          "metadata_curation"
        ]
      },
      "contributor": {
        "type": "object",
        "required": ["orcid"],
        "properties": {
          "orcid": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9X]{4}$"
          }
        }
      },
      "research_object": {
        "type": "object",
        "required": ["material_id", "repository_url"]
      },
      "scoring_inputs": {
        "type": "object",
        "required": [
          "novelty",
          "reusability",
          "reproducibility",
          "effort_proxy",
          "negative_result_value",
          "anti_spam_flag"
        ],
        "properties": {
          "novelty": {"type": "number", "minimum": 0, "maximum": 1},
          "reusability": {"type": "number", "minimum": 0, "maximum": 1},
          "reproducibility": {"type": "number", "minimum": 0, "maximum": 1},
          "effort_proxy": {"type": "number", "minimum": 0, "maximum": 1},
          "negative_result_value": {"type": "number", "minimum": 0, "maximum": 1},
          "anti_spam_flag": {"type": "boolean"}
        }
      },
      "issued_credential": {
        "type": "object",
        "required": ["credential_id", "non_transferable", "locked"],
        "properties": {
          "non_transferable": {"const": true},
          "locked": {"const": true}
        }
      },
      "validation": {
        "type": "object",
        "required": [
          "metadata_status",
          "evidence_file_status",
          "file_integrity_status",
          "source_link_status",
          "scientific_assessment",
          "verifier",
          "timestamp_utc"
        ],
        "properties": {
          "metadata_status": {
            "enum": ["not_checked", "metadata_validated", "metadata_invalid"]
          },
          "evidence_file_status": {
            "enum": ["not_checked", "evidence_file_present", "evidence_file_missing"]
          },
          "file_integrity_status": {
            "enum": ["not_checked", "file_integrity_confirmed", "file_integrity_failed"]
          },
          "source_link_status": {
            "enum": ["not_checked", "source_link_recorded", "source_link_resolved", "source_link_failed"]
          },
          "scientific_assessment": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {
                "enum": ["not_reviewed", "simulated_review", "scientifically_reviewed", "scientifically_disputed"]
              }
            }
          },
          "verifier": {
            "type": "object",
            "required": ["type", "identifier"]
          },
          "timestamp_utc": {
            "type": "string",
            "pattern": "Z$"
          }
        }
      }
    }
  }
}
