{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contribution_schema.json",
  "title": "Synthetic contribution events - v0.3.5-alpha",
  "description": "Synthetic, non-financial contribution events with modular generic and MOF research-object branches and separate metadata, evidence-file, file-integrity, source-link and scientific-assessment states.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "event_id",
      "schema_version",
      "contribution_type",
      "contributor",
      "research_object",
      "evidence",
      "validation",
      "scoring_inputs",
      "issued_credential"
    ],
    "properties": {
      "event_id": {
        "type": "string",
        "pattern": "^MCT-EVT-[0-9]{4}$"
      },
      "schema_version": {
        "type": "string",
        "const": "0.3.5-alpha"
      },
      "contribution_type": {
        "type": "string",
        "enum": [
          "mof_dataset_deposition",
          "negative_synthesis_record",
          "replication_study",
          "peer_validation",
          "sample_sharing",
          "model_provenance_record",
          "metadata_curation"
        ]
      },
      "contributor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name",
          "orcid",
          "institution"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "orcid": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
          },
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "orcid_validation_scope": {
            "type": "string",
            "const": "format_and_checksum_only",
            "description": "Format/checksum validation does not claim a live ORCID registry lookup."
          }
        }
      },
      "research_object": {
        "oneOf": [
          {
            "$ref": "#/$defs/genericResearchObject"
          },
          {
            "$ref": "#/$defs/mofResearchObject"
          }
        ]
      },
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "links",
          "metadata_hash",
          "license"
        ],
        "properties": {
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "metadata_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      },
      "validation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metadata_status",
          "evidence_file_status",
          "file_integrity_status",
          "source_link_status",
          "scientific_assessment",
          "verifier",
          "timestamp_utc",
          "conflict_declaration"
        ],
        "properties": {
          "metadata_status": {
            "enum": [
              "not_checked",
              "metadata_validated",
              "metadata_invalid"
            ]
          },
          "evidence_file_status": {
            "enum": [
              "not_checked",
              "evidence_file_present",
              "evidence_file_missing"
            ]
          },
          "file_integrity_status": {
            "enum": [
              "not_checked",
              "file_integrity_confirmed",
              "file_integrity_failed"
            ]
          },
          "source_link_status": {
            "enum": [
              "not_checked",
              "source_link_recorded",
              "source_link_resolved",
              "source_link_failed"
            ]
          },
          "scientific_assessment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "notes"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_reviewed",
                  "simulated_review",
                  "scientifically_reviewed",
                  "scientifically_disputed"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "verifier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "identifier"
            ],
            "properties": {
              "type": {
                "enum": [
                  "person",
                  "system"
                ]
              },
              "identifier": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": "string",
                "minLength": 1
              },
              "identifier_scheme": {
                "enum": [
                  "orcid_format_only",
                  "system_identifier"
                ]
              }
            }
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time"
          },
          "conflict_declaration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "declared"
            ],
            "properties": {
              "declared": {
                "type": "boolean"
              },
              "details": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "scoring_inputs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "novelty",
          "reusability",
          "reproducibility",
          "effort_proxy",
          "negative_result_value",
          "anti_spam_flag"
        ],
        "properties": {
          "novelty": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reusability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reproducibility": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "effort_proxy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "negative_result_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "anti_spam_flag": {
            "type": "boolean"
          }
        }
      },
      "issued_credential": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_id",
          "non_transferable",
          "locked"
        ],
        "properties": {
          "credential_id": {
            "type": "string",
            "pattern": "^MCT-CRED-[0-9]{4}$"
          },
          "non_transferable": {
            "type": "boolean",
            "const": true
          },
          "locked": {
            "type": "boolean",
            "const": true
          },
          "registry_backend": {
            "enum": [
              "repository_database",
              "append_only_log",
              "distributed_ledger",
              "none"
            ]
          },
          "registry_record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "chain_tx_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "issued_at_utc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "$defs": {
    "genericResearchObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "title",
        "repository_url"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "pattern": "^10[.][^ /]+/.+"
        },
        "repository_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "accession_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mofResearchObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "title",
        "repository_url",
        "domain_profile"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "pattern": "^10[.][^ /]+/.+"
        },
        "repository_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "accession_id": {
          "type": "string",
          "minLength": 1
        },
        "domain_profile": {
          "$ref": "MOF_WorkedExample/mof_research_object_profile.schema.json"
        }
      }
    }
  },
  "$comment": "All examples are synthetic. The MOF branch is a thin research-object adapter, not a universal MOF reporting standard or an MPIF conformance claim. Relative references resolve inside the release bundle. File integrity does not establish scientific truth."
}
