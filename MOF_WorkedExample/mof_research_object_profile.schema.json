{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mof_research_object_profile.schema.json",
  "title": "Synthetic MOF research-object profile - v0.3.6-alpha",
  "description": "A thin synthetic MOF research-object adapter that separates metadata validation, evidence-file presence, file integrity, source-link status and scientific assessment. It is not a universal MOF reporting standard, an MPIF compatibility or conformance claim, a secured/conforming W3C Verifiable Credential, or evidence of scientific truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "profile_version",
    "synthetic_example",
    "material_identity",
    "sample_identity",
    "synthesis_lineage",
    "characterisation_evidence",
    "reported_outcome",
    "source_anchoring",
    "validation"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "mof_research_object_profile.schema.json"
    },
    "profile_version": {
      "type": "string",
      "const": "0.3.6-alpha"
    },
    "synthetic_example": {
      "type": "boolean",
      "const": true
    },
    "material_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_family",
        "display_name",
        "structure_identifier"
      ],
      "properties": {
        "framework_family": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "structure_identifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifier_type",
            "value"
          ],
          "properties": {
            "identifier_type": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sample_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "batch_id",
        "specimen_id"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "batch_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "specimen_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
        }
      }
    },
    "synthesis_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metal_precursor",
        "linker",
        "modulators",
        "solvents",
        "reaction_temperature_C",
        "reaction_duration_h",
        "workup",
        "activation"
      ],
      "properties": {
        "metal_precursor": {
          "type": "string",
          "minLength": 1
        },
        "linker": {
          "type": "string",
          "minLength": 1
        },
        "modulators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "solvents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reaction_temperature_C": {
          "type": "number",
          "minimum": -273.15,
          "maximum": 500
        },
        "reaction_duration_h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "workup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "temperature_C",
            "duration_h"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "temperature_C": {
              "type": "number",
              "minimum": -273.15,
              "maximum": 500
            },
            "duration_h": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            }
          }
        }
      }
    },
    "characterisation_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "technique",
          "claim",
          "file",
          "sha256",
          "file_status",
          "integrity_status",
          "source_link_status"
        ],
        "properties": {
          "technique": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^evidence/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "file_status": {
            "enum": [
              "not_checked",
              "evidence_file_present"
            ]
          },
          "integrity_status": {
            "enum": [
              "not_checked",
              "file_integrity_confirmed",
              "file_integrity_failed"
            ]
          },
          "source_link_status": {
            "enum": [
              "not_checked",
              "source_link_recorded",
              "source_link_resolved",
              "source_link_failed"
            ]
          }
        }
      }
    },
    "reported_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source",
        "description"
      ],
      "properties": {
        "state": {
          "enum": [
            "reported_success",
            "reported_failure",
            "reported_ambiguous",
            "reported_replication",
            "reported_retraction"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_anchoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_url",
        "record_locator",
        "license",
        "created_utc"
      ],
      "properties": {
        "repository_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "record_locator": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "created_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_status",
        "evidence_file_status",
        "file_integrity_status",
        "source_link_status",
        "scientific_assessment",
        "contributor_id",
        "verifier_id",
        "independent_verifier",
        "conflict_declaration",
        "decision_date",
        "decision_notes",
        "credential_status"
      ],
      "properties": {
        "metadata_status": {
          "enum": [
            "not_checked",
            "metadata_validated",
            "metadata_invalid"
          ]
        },
        "evidence_file_status": {
          "enum": [
            "not_checked",
            "evidence_file_present",
            "evidence_file_missing"
          ]
        },
        "file_integrity_status": {
          "enum": [
            "not_checked",
            "file_integrity_confirmed",
            "file_integrity_failed"
          ]
        },
        "source_link_status": {
          "enum": [
            "not_checked",
            "source_link_recorded",
            "source_link_resolved",
            "source_link_failed"
          ]
        },
        "scientific_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "notes"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_reviewed",
                "simulated_review",
                "scientifically_reviewed",
                "scientifically_disputed"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "contributor_id": {
          "type": "string",
          "pattern": "^(did:[a-z0-9]+:[A-Za-z0-9._:%-]+|https://orcid.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X])$"
        },
        "verifier_id": {
          "type": "string",
          "pattern": "^(did:[a-z0-9]+:[A-Za-z0-9._:%-]+|https://orcid.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X])$"
        },
        "independent_verifier": {
          "type": "boolean",
          "const": true,
          "description": "Project policy for this synthetic independently-verified worked example; not a universal W3C Verifiable Credentials rule."
        },
        "conflict_declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared",
            "details"
          ],
          "properties": {
            "declared": {
              "type": "boolean"
            },
            "details": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "decision_date": {
          "type": "string",
          "format": "date"
        },
        "decision_notes": {
          "type": "string",
          "minLength": 1
        },
        "credential_status": {
          "enum": [
            "draft",
            "issued",
            "suspended",
            "revoked",
            "superseded"
          ]
        }
      }
    }
  },
  "$comment": "All values in the distributed instance are synthetic. File existence and SHA-256 checks establish only local byte presence/integrity, not phase identity, scientific validity, source resolution, standards conformance, or W3C credential conformance."
}
