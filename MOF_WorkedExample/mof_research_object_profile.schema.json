{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mof_research_object_profile.schema.json",
  "title": "Synthetic MOF research-object profile",
  "type": "object",
  "required": [
    "profile_version",
    "synthetic_example",
    "material_identity",
    "sample_identity",
    "validation",
    "reported_outcome"
  ],
  "properties": {
    "profile_version": {"const": "0.3.4-alpha"},
    "synthetic_example": {"const": true},
    "material_identity": {"type": "object"},
    "sample_identity": {"type": "object"},
    "validation": {
      "type": "object",
      "required": [
        "metadata_status",
        "evidence_file_status",
        "file_integrity_status",
        "source_link_status",
        "scientific_assessment"
      ],
      "properties": {
        "metadata_status": {"const": "metadata_validated"},
        "evidence_file_status": {"const": "evidence_file_present"},
        "file_integrity_status": {"const": "file_integrity_confirmed"},
        "source_link_status": {"const": "source_link_recorded"},
        "scientific_assessment": {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"const": "not_reviewed"}}
        }
      }
    },
    "reported_outcome": {"type": "object"}
  }
}
